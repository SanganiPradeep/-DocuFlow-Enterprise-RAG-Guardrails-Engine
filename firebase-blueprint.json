{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile with role-based access controls and department metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Authentication UID" },
        "email": { "type": "string", "description": "User work email address" },
        "name": { "type": "string", "description": "Full name of the user" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "Access control role" },
        "department": { "type": "string", "description": "Company department" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending"], "description": "Account status" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "lastLogin": { "type": "string", "description": "ISO timestamp of last sign in" },
        "docsUploaded": { "type": "number", "description": "Count of documents uploaded" }
      },
      "required": ["uid", "email", "name", "role", "status"]
    },
    "documents": {
      "title": "Document",
      "description": "Indexed knowledge base documents for enterprise semantic search and RAG",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document unique identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "description": "File name" },
        "size": { "type": "string", "description": "Human-readable file size" },
        "type": { "type": "string", "description": "File extension / MIME type" },
        "status": { "type": "string", "enum": ["indexed", "indexing", "flagged"], "description": "Processing status" },
        "uploadedAt": { "type": "string", "description": "Upload timestamp string" },
        "content": { "type": "string", "description": "Extracted text or summary" }
      },
      "required": ["id", "userId", "name", "status"]
    },
    "chat_messages": {
      "title": "ChatMessage",
      "description": "Unified AI assistant chat history and analysis log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "sessionId": { "type": "string", "description": "Associated chat session ID" },
        "userId": { "type": "string", "description": "User ID" },
        "role": { "type": "string", "enum": ["user", "assistant", "system"], "description": "Message author" },
        "content": { "type": "string", "description": "Message text" },
        "timestamp": { "type": "string", "description": "Human readable or ISO time" }
      },
      "required": ["id", "userId", "role", "content", "timestamp"]
    },
    "chat_sessions": {
      "title": "ChatSession",
      "description": "Enterprise chat sessions stored for sidebar navigation and sharing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session unique ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "title": { "type": "string", "description": "Session title" },
        "preview": { "type": "string", "description": "Last message preview" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "targetDoc": { "type": "string", "description": "Associated document name or ID" }
      },
      "required": ["id", "userId", "title", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User accounts and access roles"
    },
    "/documents/{documentId}": {
      "schema": "documents",
      "description": "Enterprise documents uploaded by users"
    },
    "/chat_messages/{messageId}": {
      "schema": "chat_messages",
      "description": "Chat interactions for the unified assistant"
    },
    "/chat_sessions/{sessionId}": {
      "schema": "chat_sessions",
      "description": "User chat conversation threads"
    }
  }
}
